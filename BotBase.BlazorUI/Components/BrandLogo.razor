@* Размеры округляем до целых: дробные числа при русской локали выводились с запятой («19,72»),
   и браузер отбрасывал такие атрибуты SVG и CSS. *@
<div class="bb-logo" style="width:@(Size)px;height:@(Size)px;border-radius:@(Radius)px">
    <svg width="@IconSize" height="@IconSize" viewBox="0 0 24 24" fill="none">
        <rect x="4" y="7" width="16" height="12" rx="4" fill="white" />
        <circle cx="9.5" cy="13" r="1.6" fill="#5B4AE0" /><circle cx="14.5" cy="13" r="1.6" fill="#5B4AE0" />
        <rect x="11.2" y="3" width="1.6" height="4" rx=".8" fill="white" /><circle cx="12" cy="3" r="1.4" fill="white" />
    </svg>
</div>

@code {
    [Parameter] public int Size { get; set; } = 38;

    int IconSize => (int)Math.Round(Size * 0.58);
    int Radius => (int)Math.Round(Size * 0.29);
}
