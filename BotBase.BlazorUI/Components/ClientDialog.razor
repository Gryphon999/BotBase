@* Карточка клиента: контакты, заметки, история визитов. Без Client — добавление нового клиента. *@
@inject ApiClient Api
@inject IDialogService Dialogs

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Rounded.Person" Class="mr-2" Style="vertical-align:middle" />@(Client?.Name ?? "Новый клиент")</MudText>
    </TitleContent>
    <DialogContent>
        @if (Client is not null)
        {
            <div class="d-flex flex-wrap gap-2 mb-4">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">Визитов: @Client.Visits</MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success">Потратил: @Fmt.Money(Client.TotalSpent)</MudChip>
                @if (Client.HasTelegram)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Custom.Brands.Telegram">Пишет боту — получает напоминания</MudChip>
                }
            </div>
        }
        <div class="d-flex gap-3 flex-wrap">
            <MudTextField @bind-Value="_name" Label="Имя" Variant="Variant.Outlined" Style="flex:1;min-width:180px" />
            <MudTextField @bind-Value="_phone" Label="Телефон" Variant="Variant.Outlined" InputType="InputType.Telephone" Style="flex:1;min-width:180px" />
        </div>
        <MudTextField @bind-Value="_notes" Label="Заметки" Variant="Variant.Outlined" Lines="3" Class="mt-3"
                      Placeholder="Например: аллергия на латекс, любит кофе без сахара, предпочитает мастера Анну" />
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }

        @if (Client is not null)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-5 mb-2" Style="font-weight:700">История визитов</MudText>
            @if (_history is null)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (_history.Count == 0)
            {
                <MudText Class="bb-sub">Пока нет записей.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Elevation="0" Bordered="false">
                    <tbody>
                        @foreach (var a in _history)
                        {
                            <tr style="@(a.IsCancelled ? "opacity:.5" : "")">
                                <td style="white-space:nowrap">@Fmt.DayTime(a.ScheduledAt)</td>
                                <td>@a.ProcedureName@(a.MasterName is null ? "" : $" · {a.MasterName}")</td>
                                <td style="white-space:nowrap;text-align:right">@(a.Price is { } p ? Fmt.Money(p) : "")</td>
                                <td style="white-space:nowrap">@Status(a)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (Client is not null)
        {
            <MudButton StartIcon="@Icons.Material.Rounded.EventAvailable" Color="Color.Primary" OnClick="() => MudDialog.Close(DialogResult.Ok(BookAction))">Записать</MudButton>
            <MudButton StartIcon="@Icons.Material.Rounded.DeleteForever" Color="Color.Error" OnClick="EraseData" Disabled="_saving">Удалить данные</MudButton>
            <MudSpacer />
        }
        <MudButton OnClick="() => MudDialog.Cancel()">Закрыть</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_saving">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public const string BookAction = "book", DeletedAction = "deleted";

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ClientItem? Client { get; set; }

    string _name = "", _phone = "";
    string? _notes, _error;
    bool _saving;
    List<AppointmentItem>? _history;

    protected override async Task OnInitializedAsync()
    {
        _name = Client?.Name ?? "";
        _phone = Client?.Phone ?? "";
        _notes = Client?.Notes;
        if (Client is not null)
            _history = (await Api.GetAppointmentsAsync(clientId: Client.Id)).OrderByDescending(a => a.ScheduledAt).ToList();
    }

    static string Status(AppointmentItem a) => a switch
    {
        { IsCancelled: true } => "отменено",
        { NoShow: true } => "не пришёл",
        _ when a.ScheduledAt > DateTime.Now => "предстоит",
        { Rating: { } r } => $"{r} ⭐",
        _ => "был"
    };

    // Клиент попросил удалить его данные (право по политике конфиденциальности).
    async Task EraseData()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Удалить данные клиента?",
            "Карточка, заметки и переписка с ботом удалятся навсегда. В прошлых записях имя и телефон заменятся на «Удалён по запросу» — визиты останутся в статистике.",
            yesText: "Удалить навсегда", cancelText: "Отмена");
        if (ok != true) return;
        _saving = true;
        _error = null;
        var resp = await Api.DeleteClientAsync(Client!.Id);
        _saving = false;
        if (resp.IsSuccessStatusCode) { MudDialog.Close(DialogResult.Ok(DeletedAction)); return; }
        _error = (await ApiClient.ProblemAsync(resp)).Error;
    }

    async Task Save()
    {
        _saving = true;
        _error = null;
        var resp = Client is null
            ? await Api.CreateClientAsync(_name, _phone, _notes)
            : await Api.UpdateClientAsync(Client.Id, _name, _phone, _notes);
        _saving = false;
        if (resp.IsSuccessStatusCode) { MudDialog.Close(DialogResult.Ok("saved")); return; }
        _error = (await ApiClient.ProblemAsync(resp)).Error;
    }
}
