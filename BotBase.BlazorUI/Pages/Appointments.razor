@page "/appointments"
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Записи — BotBase</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5">Записи клиентов</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary">
        Дни с записями показывают счётчик — кликните, чтобы увидеть кто, на какое время
        и на какую процедуру записался. Здесь же можно подтверждать или отменять записи.
    </MudText>
    <div class="d-flex align-center gap-2">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="PrevMonth" />
        <MudText Typo="Typo.h6" Style="min-width:180px;text-align:center">@_currentMonth.ToString("MMMM yyyy")</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="NextMonth" />
    </div>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}

@* Day headers — CSS grid, exactly 7 columns *@
<div style="display:grid; grid-template-columns:repeat(7,1fr); gap:4px; margin-bottom:4px;">
    @foreach (var day in new[] { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" })
    {
        <div style="text-align:center; padding:4px 0;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@day</MudText>
        </div>
    }
</div>

@* Calendar grid — foreach avoids Blazor @for loop-variable capture bug *@
<div style="display:grid; grid-template-columns:repeat(7,1fr); gap:4px;">
    @foreach (var cell in CalendarCells())
    {
        if (cell is null)
        {
            <div style="min-height:64px;"></div>
        }
        else
        {
            var day = cell.Value;
            var date = new DateTime(_currentMonth.Year, _currentMonth.Month, day);
            var count = AppointmentCountFor(date);
            var isSelected = _selectedDate?.Date == date.Date;
            var isToday = date.Date == DateTime.Today;
            var cellDate = date;

            <MudPaper Class="pa-2" Style="@($"min-height:64px;cursor:pointer;{(isSelected ? "border:2px solid var(--mud-palette-primary);" : "")}{(isToday ? "background:var(--mud-palette-primary-lighten);" : "")}")"
                      Elevation="@(isSelected ? 4 : 1)"
                      @onclick="() => SelectDate(cellDate)">
                <MudText Typo="Typo.body2" Color="@(isToday ? Color.Primary : Color.Default)">
                    <strong>@day</strong>
                </MudText>
                @if (count > 0)
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mt-1">
                        @count зап.
                    </MudChip>
                }
            </MudPaper>
        }
    }
</div>

@* Expanded day panel *@
@if (_selectedDate.HasValue)
{
    var dayAppts = AppointmentsFor(_selectedDate.Value);
    <MudPaper Class="pa-4 mt-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">
            @_selectedDate.Value.ToString("d MMMM yyyy")
            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="ml-2">@dayAppts.Count записей</MudChip>
        </MudText>

        @if (dayAppts.Count == 0)
        {
            <MudAlert Severity="Severity.Info">На этот день записей нет.</MudAlert>
        }
        else
        {
            <MudTable Items="dayAppts" Hover="true" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Время</MudTh>
                    <MudTh>Процедура</MudTh>
                    <MudTh>Клиент</MudTh>
                    <MudTh>Телефон</MudTh>
                    <MudTh>Длит.</MudTh>
                    <MudTh>Статус</MudTh>
                    <MudTh>Действия</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ScheduledAt.ToLocalTime().ToString("HH:mm")</MudTd>
                    <MudTd>@context.ProcedureName</MudTd>
                    <MudTd>@context.ClientName</MudTd>
                    <MudTd>@context.ClientPhone</MudTd>
                    <MudTd>@context.DurationMinutes мин</MudTd>
                    <MudTd>
                        <MudChip T="string" Color="@StatusColor(context.Status)" Size="Size.Small">
                            @StatusLabel(context.Status)
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        @if (context.Status == "Pending")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success"
                                           Size="Size.Small" OnClick="@(() => Confirm(context))" />
                        }
                        @if (context.Status != "Cancelled")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Error"
                                           Size="Size.Small" OnClick="@(() => Cancel(context))" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
}

@code {
    DateTime _currentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    DateTime? _selectedDate;
    bool _loading;
    List<AppointmentDto> _monthAppointments = [];
    string? _token;

    int StartOffset => ((int)_currentMonth.DayOfWeek + 6) % 7; // Mon=0, Sun=6
    int DaysInMonth => DateTime.DaysInMonth(_currentMonth.Year, _currentMonth.Month);

    // Returns null for empty leading cells, day number for actual days
    IEnumerable<int?> CalendarCells()
    {
        for (int i = 0; i < StartOffset; i++) yield return null;
        for (int d = 1; d <= DaysInMonth; d++) yield return d;
    }

    int AppointmentCountFor(DateTime date) =>
        _monthAppointments.Count(a => a.ScheduledAt.ToLocalTime().Date == date.Date);

    List<AppointmentDto> AppointmentsFor(DateTime date) =>
        _monthAppointments
            .Where(a => a.ScheduledAt.ToLocalTime().Date == date.Date)
            .OrderBy(a => a.ScheduledAt)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _token = await JS.InvokeAsync<string>("localStorage.getItem", "jwt");
        await LoadMonthAsync();
    }

    async Task LoadMonthAsync()
    {
        _loading = true;
        try
        {
            var monthParam = _currentMonth.ToString("yyyy-MM");
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/appointments?month={monthParam}");
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _token);
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
                _monthAppointments = await response.Content.ReadFromJsonAsync<List<AppointmentDto>>() ?? [];
        }
        finally { _loading = false; }
    }

    void SelectDate(DateTime date)
    {
        _selectedDate = _selectedDate?.Date == date.Date ? null : date;
    }

    async Task PrevMonth()
    {
        _currentMonth = _currentMonth.AddMonths(-1);
        _selectedDate = null;
        await LoadMonthAsync();
    }

    async Task NextMonth()
    {
        _currentMonth = _currentMonth.AddMonths(1);
        _selectedDate = null;
        await LoadMonthAsync();
    }

    Task Confirm(AppointmentDto appt) => SetStatus(appt, "Confirmed");
    Task Cancel(AppointmentDto appt)  => SetStatus(appt, "Cancelled");

    async Task SetStatus(AppointmentDto appt, string status)
    {
        var request = new HttpRequestMessage(HttpMethod.Patch, $"api/appointments/{appt.Id}/status")
        {
            Content = JsonContent.Create(new { Status = status })
        };
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _token);
        var response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add(status == "Confirmed" ? "Запись подтверждена" : "Запись отменена",
                         status == "Confirmed" ? Severity.Success : Severity.Warning);
            await LoadMonthAsync();
        }
    }

    static Color StatusColor(string status) => status switch
    {
        "Confirmed" => Color.Success,
        "Cancelled" => Color.Error,
        _           => Color.Warning
    };

    static string StatusLabel(string status) => status switch
    {
        "Confirmed" => "Подтверждено",
        "Cancelled" => "Отменено",
        _           => "Ожидание"
    };

    record AppointmentDto(
        Guid Id, string ProcedureName, string ClientName, string ClientPhone,
        DateTime ScheduledAt, int DurationMinutes, string Status,
        DateTime CreatedAt, DateTime UpdatedAt);
}
