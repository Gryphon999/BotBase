@page "/reset-password"
@layout EmptyLayout
@inject ApiClient Api

<PageTitle>Новый пароль · BotBase</PageTitle>

<div class="bb-auth">
    <AuthHero />
    <div class="bb-auth-form">
        <div class="bb-auth-card bb-fade-in">
            <div class="bb-auth-mobile-brand"><BrandLogo Size="34" /> BotBase</div>
            @if (!_done)
            {
                <h2>Новый пароль</h2>
                <div class="bb-sub">Придумайте пароль не короче 6 символов.</div>
                <EditForm Model="this" OnValidSubmit="Submit">
                    <MudTextField @bind-Value="_password" Label="Новый пароль" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-4" />
                    <MudTextField @bind-Value="_confirm" Label="Повторите пароль" InputType="InputType.Password" Variant="Variant.Outlined" />
                    @if (_error is not null)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
                    }
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Class="mt-6" Disabled="_loading">Сохранить пароль</MudButton>
                </EditForm>
                <MudText Class="mt-6 bb-sub" Align="Align.Center"><MudLink Href="/forgot-password" Style="font-weight:700">Запросить новую ссылку</MudLink></MudText>
            }
            else
            {
                <div style="width:56px;height:56px;border-radius:16px;background:#ECFDF5;display:grid;place-items:center;margin-bottom:18px">
                    <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Style="color:#10B981;font-size:30px" />
                </div>
                <h2>Пароль обновлён</h2>
                <div class="bb-sub">Теперь войдите с новым паролем.</div>
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">Войти</MudButton>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }
    string _password = "", _confirm = "";
    string? _error;
    bool _loading, _done;

    async Task Submit()
    {
        _error = null;
        if (string.IsNullOrEmpty(Token)) { _error = "Ссылка неполная. Откройте её из письма ещё раз."; return; }
        if (_password.Length < 6) { _error = "Пароль должен быть не короче 6 символов"; return; }
        if (_password != _confirm) { _error = "Пароли не совпадают"; return; }
        _loading = true;
        var resp = await Api.ResetPasswordAsync(Token, _password);
        _loading = false;
        if (resp.IsSuccessStatusCode) _done = true;
        else _error = (await resp.Content.ReadFromJsonAsync<ErrorDto>())?.Error ?? "Ссылка устарела. Запросите восстановление ещё раз.";
    }

    record ErrorDto(string Error);
}
