@page "/login"
@layout EmptyLayout
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Вход · BotBase</PageTitle>

<div class="bb-auth">
    <AuthHero />
    <div class="bb-auth-form">
        <div class="bb-auth-card bb-fade-in">
            <div class="bb-auth-mobile-brand"><BrandLogo Size="34" /> BotBase</div>
            <h2>С возвращением</h2>
            <div class="bb-sub">Войдите, чтобы управлять своим ботом</div>
            <EditForm Model="this" OnValidSubmit="Submit">
                <MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Variant="Variant.Outlined" Class="mb-4" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Mail" />
                <MudTextField @bind-Value="_password" Label="Пароль" InputType="@(_show ? InputType.Text : InputType.Password)" Variant="Variant.Outlined"
                              Adornment="Adornment.End" AdornmentIcon="@(_show ? Icons.Material.Rounded.VisibilityOff : Icons.Material.Rounded.Visibility)" OnAdornmentClick="() => _show = !_show" />
                <div class="d-flex justify-end mt-2"><MudLink Href="/forgot-password" Typo="Typo.body2" Style="font-weight:600">Забыли пароль?</MudLink></div>
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
                }
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_loading" FullWidth="true" Size="Size.Large" Class="mt-6">
                    @(_loading ? "Входим..." : "Войти")
                </MudButton>
            </EditForm>
            <MudText Class="mt-6 bb-sub" Align="Align.Center">Нет аккаунта? <MudLink Href="/register" Typo="Typo.body1" Style="font-weight:700">Зарегистрироваться</MudLink></MudText>
        </div>
    </div>
</div>

@code {
    string _email = "", _password = "";
    string? _error;
    bool _loading, _show;

    async Task Submit()
    {
        _loading = true;
        _error = null;
        var resp = await Api.LoginAsync(_email, _password);
        if (resp.IsSuccessStatusCode)
        {
            var result = await resp.Content.ReadFromJsonAsync<LoginResponse>();
            await JS.InvokeVoidAsync("localStorage.setItem", "jwt", result!.Token);
            await JS.InvokeVoidAsync("localStorage.setItem", "businessName", result.BusinessName);
            await JS.InvokeVoidAsync("localStorage.removeItem", "impersonating");
            Api.SetToken(result.Token);
            Nav.NavigateTo("/dashboard");
        }
        else
        {
            var err = resp.StatusCode == System.Net.HttpStatusCode.Forbidden
                ? (await resp.Content.ReadFromJsonAsync<ErrorResponse>())?.Error
                : null;
            _error = err ?? "Неверный email или пароль";
        }
        _loading = false;
    }

    record LoginResponse(string Token, string BusinessName);
    record ErrorResponse(string Error);
}
