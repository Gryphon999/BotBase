@page "/knowledge"
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IDialogService Dialogs

<PageTitle>База знаний · BotBase</PageTitle>

<PageHeader Title="База знаний" Description="Загрузите файлы с информацией о вашем бизнесе — прайс-лист, FAQ, описание услуг. Бот будет отвечать клиентам на основе этих данных. Чем подробнее база знаний, тем точнее ответы." />

<MudPaper Class="pa-6 mb-6">
    <MudText Typo="Typo.h6" Class="mb-3">Загрузить файл</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">
        Поддерживаются форматы: PDF, Word (.docx), Excel (.xlsx/.xls), текст (.txt). Макс. размер 10 МБ.
    </MudText>
    <InputFile id="fileInput" OnChange="OnFileSelected" accept=".pdf,.docx,.xlsx,.xls,.txt" style="display:none" />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile" OnClick="ClickFileInput">
        Выбрать файл
    </MudButton>
    @if (_selectedFile is not null)
    {
        <MudText Typo="Typo.body2" Class="mt-2">Выбран: @_selectedFile.Name (@(_selectedFile.Size / 1024) КБ)</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Upload" Disabled="_uploading" Class="mt-2">
            @(_uploading ? "Загружаем..." : "Загрузить")
        </MudButton>
    }
    @if (_uploadError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_uploadError</MudAlert>
    }
    @if (_uploadSuccess)
    {
        <MudAlert Severity="Severity.Success" Class="mt-3">Файл успешно загружен!</MudAlert>
    }
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-3">Загруженные файлы</MudText>
@if (_chunks is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_chunks.Count == 0)
{
    <MudAlert Severity="Severity.Info">Файлы ещё не загружены. Добавьте меню, прайс-лист или FAQ.</MudAlert>
}
else
{
    @if (_chunks.Any(c => c.Broken))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            Некоторые файлы повреждены — бот не может их прочитать. Удалите их и загрузите исходные документы ещё раз.
        </MudAlert>
    }
    <MudTable Items="_chunks" Hover="true">
        <HeaderContent>
            <MudTh>Файл</MudTh>
            <MudTh>Размер текста</MudTh>
            <MudTh>Дата</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <span class="bb-kb-name" @onclick="() => View(context)">@context.FileName</span>
                @if (context.Broken)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Class="ml-2">Повреждён — загрузите заново</MudChip>
                }
                else if (context.DuplicateOf is not null)
                {
                    <MudTooltip Text="@($"Весь текст этого файла уже есть в «{context.DuplicateOf}». Его можно удалить.")">
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Class="ml-2">Повтор</MudChip>
                    </MudTooltip>
                }
            </MudTd>
            <MudTd>@context.TextLength.ToString("N0") символов</MudTd>
            <MudTd>@context.UploadedAt.ToString("dd.MM.yyyy HH:mm")</MudTd>
            <MudTd Style="white-space:nowrap">
                <MudTooltip Text="Посмотреть текст">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" OnClick="() => View(context)" />
                </MudTooltip>
                <MudTooltip Text="Удалить">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => Delete(context)" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    List<KnowledgeChunkResponse>? _chunks;
    IBrowserFile? _selectedFile;
    bool _uploading, _uploadSuccess;
    string? _uploadError;

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "jwt");
        if (token is null) { Nav.NavigateTo("/login"); return; }
        Api.SetToken(token);
        await LoadChunks();
    }

    async Task LoadChunks()
    {
        var resp = await Api.GetKnowledgeAsync();
        if (resp.IsSuccessStatusCode)
            _chunks = await resp.Content.ReadFromJsonAsync<List<KnowledgeChunkResponse>>();
    }

    async Task ClickFileInput() => await JS.InvokeVoidAsync("eval", "document.getElementById('fileInput').click()");

    void OnFileSelected(InputFileChangeEventArgs e) => _selectedFile = e.File;

    async Task Upload()
    {
        if (_selectedFile is null) return;
        _uploading = true;
        _uploadError = null;
        _uploadSuccess = false;

        var resp = await Api.UploadFileAsync(_selectedFile);
        if (resp.IsSuccessStatusCode)
        {
            _uploadSuccess = true;
            _selectedFile = null;
            await LoadChunks();
        }
        else
        {
            _uploadError = "Ошибка загрузки. Проверьте формат и размер файла.";
        }
        _uploading = false;
    }

    async Task View(KnowledgeChunkResponse chunk)
    {
        var details = await Api.GetKnowledgeItemAsync(chunk.Id);
        if (details is null) return;
        await Dialogs.ShowAsync<KnowledgeViewDialog>(chunk.FileName,
            new DialogParameters<KnowledgeViewDialog>
            {
                { x => x.FileName, details.FileName },
                { x => x.Text, details.Text },
                { x => x.Broken, details.Broken }
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
    }

    async Task Delete(KnowledgeChunkResponse chunk)
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Удалить файл?",
            $"Бот перестанет использовать информацию из «{chunk.FileName}».", yesText: "Удалить", cancelText: "Отмена");
        if (ok != true) return;
        await Api.DeleteKnowledgeAsync(chunk.Id);
        await LoadChunks();
    }

    record KnowledgeChunkResponse(Guid Id, string FileName, DateTime UploadedAt, int TextLength, bool Broken, string? DuplicateOf);
}
