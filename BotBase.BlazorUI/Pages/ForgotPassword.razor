@page "/forgot-password"
@layout EmptyLayout
@inject ApiClient Api

<PageTitle>Восстановление пароля · BotBase</PageTitle>

<div class="bb-auth">
    <AuthHero />
    <div class="bb-auth-form">
        <div class="bb-auth-card bb-fade-in">
            <div class="bb-auth-mobile-brand"><BrandLogo Size="34" /> BotBase</div>
            @if (!_sent)
            {
                <h2>Забыли пароль?</h2>
                <div class="bb-sub">Укажите email, с которым регистрировались, — пришлём ссылку для нового пароля.</div>
                <EditForm Model="this" OnValidSubmit="Submit">
                    <MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Mail" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Class="mt-6" Disabled="_loading">
                        @(_loading ? "Отправляем..." : "Прислать ссылку")
                    </MudButton>
                </EditForm>
            }
            else
            {
                <div style="width:56px;height:56px;border-radius:16px;background:#ECFDF5;display:grid;place-items:center;margin-bottom:18px">
                    <MudIcon Icon="@Icons.Material.Rounded.MarkEmailRead" Style="color:#10B981;font-size:30px" />
                </div>
                <h2>Проверьте почту</h2>
                <div class="bb-sub">Если <b>@_email</b> зарегистрирован в BotBase, мы отправили на него ссылку. Она действует 1 час. Загляните и в папку «Спам».</div>
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    Письмо не пришло? @(_supportEmail is null ? "Обратитесь к администратору BotBase" : $"Напишите в поддержку: {_supportEmail}") — администратор выдаст временный пароль.
                </MudAlert>
            }
            <MudText Class="mt-6 bb-sub" Align="Align.Center"><MudLink Href="/login" Typo="Typo.body1" Style="font-weight:700">← Вернуться ко входу</MudLink></MudText>
        </div>
    </div>
</div>

@code {
    string _email = "";
    string? _supportEmail;
    bool _loading, _sent;

    async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_email)) return;
        _loading = true;
        var resp = await Api.ForgotPasswordAsync(_email);
        _loading = false;
        if (resp.IsSuccessStatusCode)
            _supportEmail = (await resp.Content.ReadFromJsonAsync<ForgotResponse>())?.SupportEmail;
        _sent = true;
    }

    record ForgotResponse(string? SupportEmail);
}
