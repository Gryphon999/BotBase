@page "/support"
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Поддержка · BotBase</PageTitle>

<PageHeader Title="Поддержка" Description="Задайте вопрос команде BotBase. Ответ придёт сюда и на вашу почту.">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="NewTicket">Новое обращение</MudButton>
    </Actions>
</PageHeader>

<MudGrid Spacing="4">
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-2">
            @if (_tickets is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_tickets.Count == 0 && !_composing)
            {
                <div class="pa-6 text-center">
                    <MudIcon Icon="@Icons.Material.Rounded.MarkChatRead" Style="font-size:44px;color:#A78BFA" />
                    <MudText Typo="Typo.subtitle1" Class="mt-2">Обращений пока нет</MudText>
                    <MudText Typo="Typo.body2" Class="bb-sub">Если что-то не получается — напишите, поможем.</MudText>
                </div>
            }
            else
            {
                @foreach (var t in _tickets)
                {
                    <div class="bb-ticket pa-4 rounded-lg @(t.Id == _selected?.Id ? "selected" : "")" @onclick="() => Open(t.Id)">
                        <div class="d-flex justify-space-between align-center gap-2">
                            <MudText Typo="Typo.subtitle1" Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@t.Subject</MudText>
                            <StatusChip Status="@t.Status" />
                        </div>
                        <MudText Typo="Typo.body2" Class="bb-sub" Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@t.LastMessage</MudText>
                        <MudText Typo="Typo.caption" Class="bb-sub">@t.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    </div>
                }
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="8">
        @if (_composing)
        {
            <MudPaper Class="pa-6 bb-fade-in">
                <MudText Typo="Typo.h6" Class="mb-4">Новое обращение</MudText>
                <MudTextField @bind-Value="_subject" Label="Тема" Variant="Variant.Outlined" Class="mb-4" Placeholder="Например: бот не отвечает клиентам" />
                <MudTextField @bind-Value="_text" Label="Опишите вопрос" Variant="Variant.Outlined" Lines="6" />
                <div class="d-flex gap-2 mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Create" Disabled="_sending" StartIcon="@Icons.Material.Rounded.Send">Отправить</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="() => _composing = false">Отмена</MudButton>
                </div>
            </MudPaper>
        }
        else if (_selected is not null)
        {
            <MudPaper Class="pa-6 bb-fade-in">
                <div class="d-flex justify-space-between align-center mb-4 gap-2">
                    <MudText Typo="Typo.h6">@_selected.Subject</MudText>
                    <StatusChip Status="@_selected.Status" />
                </div>
                <div class="bb-chat">
                    @foreach (var m in _selected.Messages)
                    {
                        <div class="bb-msg @(m.FromAdmin ? "them" : "me")">
                            @if (m.FromAdmin) { <div style="font-weight:700;font-size:.8rem;color:#6D5DFC">Поддержка BotBase</div> }
                            @m.Text
                            <div class="bb-msg-meta">@m.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</div>
                        </div>
                    }
                </div>
                <div class="d-flex gap-2 mt-4 align-end">
                    <MudTextField @bind-Value="_reply" Label="Ваше сообщение" Variant="Variant.Outlined" Lines="2" Class="flex-grow-1" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Reply" Disabled="_sending" Style="height:56px">Отправить</MudButton>
                </div>
            </MudPaper>
        }
        else
        {
            <MudPaper Class="pa-10 text-center">
                <MudIcon Icon="@Icons.Material.Rounded.SupportAgent" Style="font-size:56px;color:#A78BFA" />
                <MudText Typo="Typo.h6" Class="mt-2">Мы на связи</MudText>
                <MudText Typo="Typo.body2" Class="bb-sub mb-4">Выберите обращение слева или создайте новое.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NewTicket">Написать в поддержку</MudButton>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    List<TicketDto>? _tickets;
    TicketDetailDto? _selected;
    bool _composing, _sending;
    string _subject = "", _text = "", _reply = "";

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "jwt");
        if (token is null) { Nav.NavigateTo("/login"); return; }
        Api.SetToken(token);
        await Reload();
    }

    async Task Reload() =>
        _tickets = await (await Api.GetTicketsAsync()).Content.ReadFromJsonAsync<List<TicketDto>>() ?? [];

    void NewTicket() { _composing = true; _selected = null; _subject = _text = ""; }

    async Task Open(Guid id)
    {
        _composing = false;
        _selected = await (await Api.GetTicketAsync(id)).Content.ReadFromJsonAsync<TicketDetailDto>();
    }

    async Task Create()
    {
        if (string.IsNullOrWhiteSpace(_subject) || string.IsNullOrWhiteSpace(_text)) { Snackbar.Add("Заполните тему и вопрос", Severity.Warning); return; }
        _sending = true;
        var resp = await Api.CreateTicketAsync(_subject, _text);
        _sending = false;
        if (!resp.IsSuccessStatusCode) { Snackbar.Add("Не удалось отправить, попробуйте ещё раз", Severity.Error); return; }
        _selected = await resp.Content.ReadFromJsonAsync<TicketDetailDto>();
        _composing = false;
        Snackbar.Add("Обращение отправлено. Мы ответим как можно скорее", Severity.Success);
        await Reload();
    }

    async Task Reply()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_reply)) return;
        _sending = true;
        var resp = await Api.ReplyTicketAsync(_selected.Id, _reply);
        _sending = false;
        if (!resp.IsSuccessStatusCode) { Snackbar.Add("Не удалось отправить", Severity.Error); return; }
        _selected = await resp.Content.ReadFromJsonAsync<TicketDetailDto>();
        _reply = "";
        await Reload();
    }

    record TicketDto(Guid Id, string Subject, string Status, DateTime CreatedAt, DateTime UpdatedAt, string? LastMessage);
    record TicketDetailDto(Guid Id, string Subject, string Status, DateTime CreatedAt, List<MessageDto> Messages);
    record MessageDto(bool FromAdmin, string Text, DateTime CreatedAt);
}
