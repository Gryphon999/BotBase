@page "/register"
@layout EmptyLayout
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Регистрация · BotBase</PageTitle>

<div class="bb-auth">
    <AuthHero />
    <div class="bb-auth-form">
        <div class="bb-auth-card bb-fade-in">
            <div class="bb-auth-mobile-brand"><BrandLogo Size="34" /> BotBase</div>
            <h2>Регистрация в BotBase</h2>
            <div class="bb-sub">Создайте кабинет — подключение бота займёт пару минут</div>
            <EditForm Model="this" OnValidSubmit="Submit">
                <MudTextField @bind-Value="_businessName" Label="Название бизнеса" Variant="Variant.Outlined" Class="mb-4" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Storefront" />
                <MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Variant="Variant.Outlined" Class="mb-4" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Mail" />
                <MudTextField @bind-Value="_password" Label="Пароль" InputType="InputType.Password" Variant="Variant.Outlined" HelperText="Не меньше 6 символов" />
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
                }
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_loading" FullWidth="true" Size="Size.Large" Class="mt-6">
                    @(_loading ? "Создаём кабинет..." : "Зарегистрироваться")
                </MudButton>
            </EditForm>
            <MudText Class="mt-6 bb-sub" Align="Align.Center">Уже есть аккаунт? <MudLink Href="/login" Typo="Typo.body1" Style="font-weight:700">Войти</MudLink></MudText>
        </div>
    </div>
</div>

@code {
    string _businessName = "", _email = "", _password = "";
    string? _error;
    bool _loading;

    async Task Submit()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_businessName) || string.IsNullOrWhiteSpace(_email)) { _error = "Заполните название и email"; return; }
        if (_password.Length < 6) { _error = "Пароль должен быть не короче 6 символов"; return; }
        _loading = true;
        var resp = await Api.RegisterAsync(_email, _password, _businessName);
        if (resp.IsSuccessStatusCode)
        {
            var result = await resp.Content.ReadFromJsonAsync<LoginResponse>();
            await JS.InvokeVoidAsync("localStorage.setItem", "jwt", result!.Token);
            await JS.InvokeVoidAsync("localStorage.setItem", "businessName", result.BusinessName);
            await JS.InvokeVoidAsync("localStorage.removeItem", "impersonating");
            Api.SetToken(result.Token);
            Nav.NavigateTo("/dashboard");
        }
        else
        {
            _error = "Этот email уже зарегистрирован";
        }
        _loading = false;
    }

    record LoginResponse(string Token, string BusinessName);
}
