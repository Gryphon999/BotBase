@page "/bot-setup"
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@using System.Net.Http.Json

<MudText Typo="Typo.h4" Class="mb-2">Настройка бота</MudText>
<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-5">
    Подключите Telegram-бота к вашему аккаунту. Вставьте токен от @BotFather — бот сразу начнёт принимать сообщения.
    Чтобы получать уведомления о новых записях, откройте своего бота и отправьте <strong>/start</strong>.
</MudText>

<MudPaper Class="pa-6 mb-6" MaxWidth="600px">
    <MudText Typo="Typo.h6" Class="mb-3">Токен бота</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">
        Создайте бота через <strong>@BotFather</strong> в Telegram и вставьте токен ниже.
        Мы автоматически зарегистрируем webhook — ваш бот начнёт принимать сообщения сразу после сохранения.
    </MudText>
    <MudTextField @bind-Value="_token"
                  Label="Bot Token (например: 123456:ABC-DEF1234...)"
                  Variant="Variant.Outlined"
                  Class="mb-4" />
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }
    @if (_success)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">Бот успешно подключён!</MudAlert>
    }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_loading">
        @(_loading ? "Сохраняем..." : "Сохранить")
    </MudButton>
</MudPaper>

<MudPaper Class="pa-6" MaxWidth="600px">
    <MudText Typo="Typo.h6" Class="mb-3">Уведомления владельца</MudText>

    @if (_ownerConnected)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">
            ✅ Вы подключены — уведомления о новых записях приходят вам в Telegram.
        </MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Error"
                   OnClick="ResetOwnerNotification" Disabled="_resetting">
            @(_resetting ? "Сбрасываем..." : "Сбросить подключение")
        </MudButton>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Уведомления не настроены. Откройте своего бота в Telegram и отправьте <strong>/start</strong> —
            бот автоматически запомнит вас как владельца.
        </MudAlert>
    }
    @if (_resetSuccess)
    {
        <MudAlert Severity="Severity.Info" Class="mt-3">Подключение сброшено. Отправьте /start боту, чтобы подключиться снова.</MudAlert>
    }
</MudPaper>

@code {
    string _token = "";
    string? _error;
    bool _success, _loading;
    bool _ownerConnected, _resetting, _resetSuccess;

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "jwt");
        if (token is null) { Nav.NavigateTo("/login"); return; }
        Api.SetToken(token);
        await LoadStatusAsync();
    }

    async Task LoadStatusAsync()
    {
        var resp = await Api.GetBotStatusAsync();
        if (resp.IsSuccessStatusCode)
        {
            var status = await resp.Content.ReadFromJsonAsync<BotStatusDto>();
            _ownerConnected = status?.OwnerConnected ?? false;
            if (status?.BotUsername is { } username)
                _token = "";
        }
    }

    async Task Save()
    {
        _loading = true;
        _error = null;
        _success = false;
        var resp = await Api.SetupBotAsync(_token.Trim());
        if (resp.IsSuccessStatusCode)
        {
            _success = true;
            await LoadStatusAsync();
        }
        else
            _error = "Не удалось подключить бота. Проверьте токен и попробуйте снова.";
        _loading = false;
    }

    async Task ResetOwnerNotification()
    {
        _resetting = true;
        _resetSuccess = false;
        var resp = await Api.ResetOwnerNotificationAsync();
        if (resp.IsSuccessStatusCode)
        {
            _ownerConnected = false;
            _resetSuccess = true;
        }
        _resetting = false;
    }

    const string BotFather = "@BotFather";

    record BotStatusDto(bool HasBot, string? BotUsername, bool IsActive, bool OwnerConnected);
}
