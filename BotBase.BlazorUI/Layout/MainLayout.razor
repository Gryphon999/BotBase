@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3">BotBase</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" Title="Выйти" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
        <MudNavMenu>
            <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">Дашборд</MudNavLink>
            <MudNavLink Href="/bot-setup" Icon="@Icons.Material.Filled.SmartToy">Настройка бота</MudNavLink>
            <MudNavLink Href="/knowledge" Icon="@Icons.Material.Filled.MenuBook">База знаний</MudNavLink>
            <MudNavLink Href="/procedures" Icon="@Icons.Material.Filled.ContentCut">Процедуры</MudNavLink>
            <MudNavLink Href="/schedule" Icon="@Icons.Material.Filled.CalendarMonth">Расписание</MudNavLink>
            <MudNavLink Href="/conversations" Icon="@Icons.Material.Filled.Forum">Разговоры</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="pa-6">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;

    void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    [Inject] NavigationManager Nav { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;

    async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "jwt");
        Nav.NavigateTo("/login");
    }
}
