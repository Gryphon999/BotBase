@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">BotBase</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Href="/login" />
    </MudAppBar>
    <MudDrawer Open="true" Elevation="2">
        <MudNavMenu>
            <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">Главная</MudNavLink>
            <MudNavLink Href="/bot-setup" Icon="@Icons.Material.Filled.SmartToy">Настройка бота</MudNavLink>
            <MudNavLink Href="/knowledge" Icon="@Icons.Material.Filled.MenuBook">База знаний</MudNavLink>
            <MudNavLink Href="/conversations" Icon="@Icons.Material.Filled.Forum">Разговоры</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="pa-6">
        @Body
    </MudMainContent>
</MudLayout>
